[Unit]
Description=Thomas's twice-weekly neuroscience paper scout
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/paper-scout/credentials.json
ConditionPathExists=/var/lib/paper-scout/cutover-ready

[Service]
Type=oneshot
User=paperscout
Group=paperscout
WorkingDirectory=/opt/paper-scout/current
ExecStart=/opt/paper-scout/venv/bin/python /opt/paper-scout/current/deploy/run_scout.py
LoadCredential=credentials.json:/etc/paper-scout/credentials.json
TimeoutStartSec=40min
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/paper-scout
PrivateTmp=true
PrivateDevices=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=512M
CPUQuota=50%
